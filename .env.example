# ETERNITY — Environment Configuration
# Copy this file to .env.local and populate with your Supabase credentials

# Supabase Project URL & Anon Public Key
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional Master Passkey for offline/local admin access during initial design testing
NEXT_PUBLIC_ADMIN_LOCAL_KEY=eternity2026
